<!DOCTYPE html>
<html lang="en">
  <%- include('head') %>

  <body>
    <main class="container">
      <h1>Our Hours</h1>

      <section>
        <div class="grid">
          <% for (let day of days) { %>
          <!-- prettier-ignore -->
          <% const hoursObj = operatingHours[day] || operatingHours['defaultHours'] %>
          <div>
            <h6><%= day.toUpperCase() %></h6>
            <% if (hoursObj.open) {%>
            <p><strong>Open:</strong> <%= hoursObj.open %></p>
            <p><strong>Closed:</strong> <%= hoursObj.closed %></p>
            <% } else {%>
            <strong>CLOSED</strong>
            <% } %>
          </div>
          <% }%>
        </div>
      </section>
    </main>

    <footer class="container">
      <small>Copyright <a href="#"> What's Fare is Fair</a></small>
    </footer>
  </body>
</html>
